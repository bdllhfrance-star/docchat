# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=docchat

# Google Gemini through @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel private Blob signed uploads
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=

# Optional only for a legacy/local static-token Blob flow
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_CALLBACK_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# At least 32 random characters used to sign anonymous sessions
APP_SECRET=
